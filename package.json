{
  "name": "wevisitor-uniapp",
  "version": "1.0.0",
  "private": true,
  "description": "WeVisitor 访客预约系统 - uni-app (Vue3 + Vite + TypeScript) 架构",
  "scripts": {
    "dev:h5": "npx uni",
    "build:h5": "npx uni build",
    "dev:mp-weixin": "npx uni -p mp-weixin",
    "build:mp-weixin": "npx uni build -p mp-weixin",
    "dev:app": "npx uni -p app",
    "build:app": "npx uni build -p app",
    "typecheck": "npx vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-h5": "3.0.0-4060620250520001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4060620250520001",
    "classnames": "^2.5.0",
    "pinia": "2.3.0",
    "vue": "3.5.13",
    "vue-i18n": "9.1.10"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.14",
    "@dcloudio/uni-automator": "3.0.0-4060620250520001",
    "@dcloudio/uni-cli-shared": "3.0.0-4060620250520001",
    "@dcloudio/uni-stacktracey": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "@types/node": "^18.15.11",
    "@vitejs/plugin-vue": "5.2.1",
    "sass": "1.83.0",
    "typescript": "5.5.4",
    "unplugin-auto-import": "0.18.5",
    "unplugin-vue-components": "0.27.5",
    "vite": "5.4.11",
    "vue-tsc": "2.1.10"
  }
}
